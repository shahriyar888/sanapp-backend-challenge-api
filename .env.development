# Development Environment - Local Django + Docker Services
# Use this when running Django locally (python manage.py runserver)

# Django Settings
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - Connect to Docker PostgreSQL on localhost
POSTGRES_DB=myproject_dev
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=secure_postgres_password_123
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis - Connect to Docker Redis on localhost
REDIS_URL=redis://localhost:6379/0

# MinIO - Connect to Docker MinIO on localhost
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=secure_minio_password_123
MINIO_USE_HTTPS=False
MINIO_BUCKET_NAME=documents
