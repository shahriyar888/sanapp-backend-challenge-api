# Production Environment - All services in Docker
# Use this with docker-compose up

# Django Settings
DEBUG=False
SECRET_KEY=your-very-secure-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database - Docker internal network
POSTGRES_DB=myproject_prod
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=secure_postgres_password_123
DATABASE_HOST=db
DATABASE_PORT=5432

# Redis - Docker internal network
REDIS_PASSWORD=secure_redis_password_123
REDIS_URL=redis://:secure_redis_password_123@redis:6379/0

# MinIO - Docker internal network
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=secure_minio_password_123
MINIO_USE_HTTPS=False
MINIO_BUCKET_NAME=documents
